# Public: safe to expose, but only NEXT_PUBLIC_SUPABASE_URL is actually
# read from this by anything here. Kept for parity with the main
# project's .env.example, in case a future read path needs it.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only: never prefix with NEXT_PUBLIC_, never import into a client
# component. This is the ONLY thing that makes writes work at all, see
# lib/supabase/admin.ts and app/admin/layout.tsx's auth guard note.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: the live customer-facing site's own URL and the shared
# secret it checks at /api/revalidate. Called after every product write
# (see products/actions.ts's revalidateCustomerSite) so a price/photo/
# availability edit shows up there immediately instead of waiting for
# its own 60s ISR window. REVALIDATE_SECRET must be the exact same
# value as the main project's own .env.local entry of the same name.
CUSTOMER_SITE_URL=
REVALIDATE_SECRET=
