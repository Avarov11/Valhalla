# Public: safe to expose to the browser. Used by server components to read the menu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never prefix with NEXT_PUBLIC_, never import into a client component.
# Used by scripts/seed.ts and scripts/upload-images.ts locally, and by
# lib/orders/create-order.ts in production (the one server action that records
# an order alongside the WhatsApp message, see CLAUDE.md, Admin dashboard, Orders).
# Get it from the Supabase dashboard (Project Settings > API).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: shared secret checked by app/api/revalidate/route.ts. The standalone
# admin/ project calls that route after every product write so a price/photo/
# availability edit shows up here immediately instead of waiting for the 60s ISR
# window. Must be the exact same value as admin/.env.local's REVALIDATE_SECRET.
REVALIDATE_SECRET=
