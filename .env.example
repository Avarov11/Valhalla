# Public: safe to expose to the browser. Used by server components to read the menu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: never prefix with NEXT_PUBLIC_, never import into a client component.
# Used only by scripts/seed.ts and scripts/upload-images.ts to write data and upload
# photos. Get it from the Supabase dashboard (Project Settings > API).
SUPABASE_SERVICE_ROLE_KEY=
